<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="custom_maze">
    <static>true</static>
    <link name="link">
      
      <pose>0 0 0.001 -1.5708 0 0</pose> 

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://custom_maze/meshes/maze.stl</uri>
            <scale>12 12 12</scale> 
          </mesh>
        </geometry>
      </collision>
      
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://custom_maze/meshes/maze.stl</uri>
            <scale>12 12 12</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>