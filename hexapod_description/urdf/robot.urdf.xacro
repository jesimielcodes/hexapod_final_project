<?xml version="1.0" ?>
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_mass" value="1.0"/>
  <xacro:property name="base_length" value="0.3"/>
  <xacro:property name="base_width" value="0.2"/>
  <xacro:property name="base_height" value="0.1"/>

  <xacro:property name="leg_segment_mass" value="0.9"/>
  <xacro:property name="leg_connector_mass" value="0.5"/>
  <xacro:property name="leg_segment_dim" value="0.05"/>
  
  <xacro:property name="dummy_mass" value="0.1"/>

  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(mass/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(mass/12) * (x*x + z*z)}" iyz="0.0"
               izz="${(mass/12) * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="dummy_inertial">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${dummy_mass}"/>
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
  </xacro:macro>

  <xacro:include filename="$(find hexapod_description)/urdf/lidar.xacro"/>
  <xacro:lidar parent_link="part_1"/>

  <link name="part_1">
    <xacro:box_inertial mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <link name="part_1_2"><xacro:dummy_inertial/></link>
  <link name="part_1_3"><xacro:dummy_inertial/></link>
  <link name="part_1_4"><xacro:dummy_inertial/></link>
  <link name="part_1_5"><xacro:dummy_inertial/></link>
