  <link name="part_1_3_part_1_4">
    <xacro:box_inertial mass="${leg_connector_mass}" x="${leg_segment_dim}" y="${leg_segment_dim}" z="${leg_segment_dim}"><origin xyz="-3.99804e-05 -0.000637011 -0.00633873" rpy="0 0 0"/></xacro:box_inertial>
    <visual><origin xyz="0 0 -0" rpy="-0 -0 -0"/><geometry><mesh filename="package://hexapod_description/assets/part_1__3.stl"/></geometry><material name="part_1_4_material"><color rgba="0 0 0 1"/></material></visual>
    <collision><origin xyz="0 0 -0" rpy="-0 -0 -0"/><geometry><mesh filename="package://hexapod_description/assets/part_1__3.stl"/></geometry></collision>
  </link>
  <joint name="part_1_3_part_1_4_fixed" type="fixed"><origin xyz="-0 -0.0618 0.014594" rpy="-1.5708 1.5708 0"/><parent link="part_1_3"/><child link="part_1_3_part_1_4"/><axis xyz="0 0 1"/></joint>

